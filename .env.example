# Доступ до адмін-панелі /admin (обовʼязково для роботи /admin/login)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Публічний URL сайту для SEO, sitemap і og-тегів
NEXT_PUBLIC_SITE_URL=https://did-panas.shop

# Ключ API Нової пошти (https://dev-api.novaposhta.ua — розділ «Ключі доступу»).
# Необовʼязковий: без нього автопідказки міст/відділень/поштоматів/вулиць на
# /checkout вимикаються, але замовлення можна оформити вручну.
# Ключ читається лише на сервері (route handlers), у браузер не потрапляє.
NOVA_POSHTA_API_KEY=

# --- Cloudinary: постійне зберігання фотографій (рекомендовано) -------------
# Дані з Cloudinary Dashboard → Product Environment Credentials
# (Cloud name / API key / API secret). Детальна інструкція в README,
# розділ «Постійне зберігання фотографій через Cloudinary».
# Без цих значень локальна розробка працює у режимі public/uploads/,
# але на Vercel завантажені файли НЕ зберігатимуться між розгортаннями.
#
# Назва акаунта (Cloudinary Dashboard → Product Environment Credentials → Cloud name).
CLOUDINARY_CLOUD_NAME=
# API key того самого акаунта (відкрите ідентифікаційне значення).
CLOUDINARY_API_KEY=
# API secret. ЛИШЕ серверне середовище, НІКОЛИ не NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=

# --- Cloudflare R2: альтернативне постійне зберігання фотографій ------------
# Використовується лише якщо Cloudinary НЕ налаштовано (детальна інструкція
# в README, розділ «Постійне зберігання фотографій через Cloudflare R2»).
#
# Account ID: R2 → Overview (права колонка «Account ID»).
R2_ACCOUNT_ID=
# API token: R2 → Manage R2 API Tokens → Create API token
# (найменші права: Object Read & Write для вказаного бакета).
R2_ACCESS_KEY_ID=
# Секрет того самого токена. ЛИШЕ серверне середовище, НІКОЛИ не NEXT_PUBLIC_.
R2_SECRET_ACCESS_KEY=
# Назва бакета (R2 → Buckets → назва, наприклад did-panas-images).
R2_BUCKET_NAME=
# Публічний base URL для читання фотографій покупцями, без сліда в кінці:
# власний домен (https://images.did-panas.shop) або R2.dev
# (https://pub-<id>.r2.dev — R2 → bucket → Settings → Public Development URL).
R2_PUBLIC_BASE_URL=
